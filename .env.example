# Telegram
# Reemplazá por el token real provisto por @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# IDs de chat separados por coma. Ejemplo: 123456789,987654321
TELEGRAM_ADMIN_CHAT_IDS=123456789
# Si se completa, el bot solo atiende esos chats. Vacío = cualquier chat.
TELEGRAM_ALLOWED_CHAT_IDS=

# true = no llama a Telegram; útil para tests y demo sin token.
BOT_DRY_RUN=false
BOT_POLLING_TIMEOUT=30
BOT_RETRY_DELAY_MS=2000

# Si se define, el bot usa webhook en lugar de polling. Debe ser HTTPS.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
PORT=3001

# Backend de Laborin (solo lectura desde el bot)
# Debe apuntar a la base /api/v1 del backend.
LABORIN_API_BASE_URL=http://localhost:3000/api/v1
# Token JWT provisto por el equipo del backend. Si falta, /categorias y /estado
# responden con instrucciones en lugar de fallar.
LABORIN_API_ACCESS_TOKEN=

# Canales web y móvil (gateway HTTP del bot)
WEB_CHANNEL_PATH=/channels/web
MOBILE_CHANNEL_PATH=/channels/mobile
# Secreto compartido enviado como header x-channel-token. Vacío = sin autenticar.
CHANNEL_AUTH_TOKEN=cambiar-por-un-secreto-largo
# Secreto para firmar/verificar tokens de deep-link que vinculan usuario ↔ chat.
BOT_LINKING_SECRET=cambiar-por-otro-secreto-largo

# Links públicos
LABORIN_APP_URL=https://app.laborin.app/
LABORIN_LANDING_URL=https://laborin.app/

LOG_LEVEL=info
